{
  "name": "mui-rest-list",
  "version": "3.1.0",
  "main": "lib/src/components/index.js",
  "types": "lib/src/components/index.d.ts",
  "files": [
    "lib",
    "lib-esm"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:cjs": "tsc --outDir lib",
    "build:esm": "tsc --outDir lib-esm --module esnext --moduleResolution node --declaration false && node scripts/finalizeEsmBuild.cjs",
    "prepublishOnly": "npm run build"
  },
  "repository": "https://github.com/MishaKanai/mui-rest-list.git",
  "author": "Misha Kanai",
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "7.22.9",
    "@babel/preset-react": "7.22.5",
    "@babel/preset-typescript": "7.22.5",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@storybook/addon-essentials": "^7.1.1",
    "@storybook/addon-interactions": "^7.1.1",
    "@storybook/addon-knobs": "7.0.2",
    "@storybook/addon-links": "^7.1.1",
    "@storybook/addon-onboarding": "^1.0.8",
    "@storybook/blocks": "^7.1.1",
    "@storybook/react": "^7.1.1",
    "@storybook/react-webpack5": "^7.1.1",
    "@storybook/testing-library": "^0.2.0",
    "@types/jest": "26.0.7",
    "@types/lodash.get": "4.4.6",
    "@types/lodash.uniqueid": "4.0.6",
    "@types/node": "14.0.26",
    "@types/react": "17.0.83",
    "babel-loader": "8.1.0",
    "fork-ts-checker-webpack-plugin": "5.0.11",
    "jest": "26.1.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-refresh": "0.14.2",
    "rxjs": "6.6",
    "storybook": "^7.1.1",
    "ts-jest": "26.1.3",
    "ts-loader": "8.0.1",
    "typescript": "5.0.4",
    "webpack": "5.110.2"
  },
  "dependencies": {
    "@devexperts/remote-data-ts": "2.0.3",
    "lodash.get": "4.4.2",
    "lodash.uniqueid": "4.0.1"
  },
  "peerDependencies": {
    "@mui/icons-material": "^6.0.0 || ^7.0.0",
    "@mui/material": "^6.0.0 || ^7.0.0",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "rxjs": "^6.6.0"
  },
  "resolutions": {
    "@types/react": "^17.0.83",
    "jackspeak": "2.1.1"
  },
  "module": "lib-esm/src/components/index.js",
  "exports": {
    ".": {
      "types": "./lib/src/components/index.d.ts",
      "import": "./lib-esm/src/components/index.js",
      "require": "./lib/src/components/index.js",
      "default": "./lib/src/components/index.js"
    },
    "./lib/src/components": {
      "types": "./lib/src/components/index.d.ts",
      "import": "./lib-esm/src/components/index.js",
      "require": "./lib/src/components/index.js",
      "default": "./lib/src/components/index.js"
    },
    "./lib/src/components/Pagination": {
      "types": "./lib/src/components/Pagination/index.d.ts",
      "import": "./lib-esm/src/components/Pagination/index.js",
      "require": "./lib/src/components/Pagination/index.js",
      "default": "./lib/src/components/Pagination/index.js"
    },
    "./lib/src/components/states": {
      "types": "./lib/src/components/states/index.d.ts",
      "import": "./lib-esm/src/components/states/index.js",
      "require": "./lib/src/components/states/index.js",
      "default": "./lib/src/components/states/index.js"
    },
    "./lib/*.js": {
      "types": "./lib/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib/*.js",
      "default": "./lib/*.js"
    },
    "./lib/*": {
      "types": "./lib/*.d.ts",
      "import": "./lib-esm/*.js",
      "require": "./lib/*.js",
      "default": "./lib/*.js"
    },
    "./package.json": "./package.json"
  }
}
